JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
FRONTEND_ORIGIN=http://localhost:3000
PORT=8080
DB_PATH=lms_data.db
AUTO_BACKUP=true
# For first administrator only, run go run . -bootstrap-admin
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_EMAIL=admin@school.example
# BOOTSTRAP_ADMIN_PASSWORD=set-a-unique-password

# Private file storage; leave S3_BUCKET empty for local/demo storage.
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
